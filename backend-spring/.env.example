# Copy as .env.local; never commit local credentials.
DB_URL=jdbc:postgresql://localhost:5432/asistencia
DB_USER=postgres
DB_PASSWORD=
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
PORT=8080
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
# Optional for actual recovery emails:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_STARTTLS=true
MAIL_FROM=
